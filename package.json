{
  "name": "storeboost-pro",
  "private": true,
  "version": "1.0.0",
  "description": "StoreBoost Pro — Image Optimization Opportunity Scanner for Shopify",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "worker": "tsx watch workers/optimization.worker.ts",
    "worker:prod": "tsx workers/optimization.worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "engines": {
    "node": ">=18.20.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@shopify/shopify-app-remix": "^5.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^5.2.3",
    "@shopify/polaris": "^13.9.5",
    "@remix-run/node": "^2.14.0",
    "@remix-run/react": "^2.14.0",
    "@remix-run/serve": "^2.14.0",
    "bullmq": "^5.30.0",
    "ioredis": "^5.4.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8",
    "isbot": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.14.0",
    "@shopify/app": "^3.58.2",
    "@shopify/cli": "^3.58.2",
    "@shopify/app-bridge-react": "^4.2.13",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/sharp": "^0.31.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}